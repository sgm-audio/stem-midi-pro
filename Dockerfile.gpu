# SPDX-License-Identifier: PolyForm-Small-Business-1.0.0
# Multi-stage Dockerfile for Stem+MIDI Pro GPU fine-tune (Demucs separator only)
# Target: RunPod / cloud GPU with NVIDIA CUDA

# ============================================================
# Stage 1: Builder (CUDA-enabled)
# ============================================================
FROM nvidia/cuda:12.3.2-runtime-ubuntu22.04 AS builder

# Install system deps + build tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.13-venv \
    python3-pip \
    build-essential \
    git \
    curl \
    wget \
    ca-certificates \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/*

# Create app user
RUN useradd -m -u 1000 appuser

# Set env vars before pip
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

# Install Python deps (CPU pin first, then overlay CUDA deps)
WORKDIR /app

# Copy requirements
COPY requirements.txt .
RUN pip install --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# Install CUDA-enabled Demucs + deps
# Demucs v4+ with CUDA 12 support uses torchvision from torch repo
RUN pip install --no-cache-dir \
    "demucs[extra]" \
    "torch>=2.11.0+cu121" \
    "torchvision>=0.14.0+cu121" \
    "torchaudio>=2.11.0+cu121" \
    "auraloss>=0.4.0" \
    && python -c "import torch; print('CUDA available:', torch.cuda.is_available())"

# Copy application
COPY . .

# Stage 2: Runtime
FROM nvidia/cuda:12.3.2-runtime-ubuntu22.04

WORKDIR /app

# Create non-root user
RUN useradd -m -u 1000 appuser

# Copy installed packages from builder
COPY --from=builder /usr/local/lib/python3.13/site-packages /usr/local/lib/python3.13/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

# Copy application
COPY --chown=appuser:appuser . .

# Create directories
RUN mkdir -p /app/data /app/outputs /app/checkpoints /app/user_content && \
    chown -R appuser:appuser /app

USER appuser

# Expose API port
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --start-period=30s \
    CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://localhost:8000/live')"] || exit 1

# Run with graceful shutdown
CMD ["uvicorn", "api:app", "--host", "0.0.0.0", "--port", "8000", "--timeout-graceful-shutdown", "30"]